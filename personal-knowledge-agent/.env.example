# ===== LLM (any OpenAI-compatible endpoint) ==================================
# The adapter speaks plain OpenAI chat-completions, so DeepSeek, Zhipu BigModel
# and other compatible providers all work — only these three values change.
#
# DeepSeek — API key from https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# deepseek-flash (DeepSeek-V4.1-Flash, cheapest) or deepseek-v4-pro (stronger).
# Both support tool calls, with or without thinking mode.
# NOTE: the legacy ids deepseek-chat / deepseek-reasoner are RETIRED — using
# them will fail. Use the two ids above.
LLM_MODEL=deepseek-flash
#
# To run on Zhipu GLM-5.2 instead, replace the three values above with:
#   LLM_API_KEY=<key from https://open.bigmodel.cn>
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-5.2

# ===== Embedding =============================================================
# Backend: zhipu (OpenAI-compatible API, needs an embedding resource pack) or
# local (sentence-transformers, fully offline).
EMBEDDING_BACKEND=local
# Local embedding model (only used when EMBEDDING_BACKEND=local)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- Zhipu embedding backend (only used when EMBEDDING_BACKEND=zhipu) --------
# Deliberately separate from the LLM settings above: DeepSeek offers no
# embedding endpoint, so switching the LLM to DeepSeek must not break the
# zhipu embedding backend.
# Zhipu embedding model id
EMBEDDING_MODEL=embedding-3
# Zhipu credentials for embeddings
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== Storage paths =========================================================
# Directory containing your knowledge base markdown files (indexed on startup)
KB_DIR=./data/kb
# Directory where create_note writes new markdown notes
NOTES_DIR=./data/notes
# Persistent ChromaDB storage location
CHROMA_DB_DIR=./data/chroma
# Knowledge base collection name
CHROMA_COLLECTION_NAME=personal_knowledge

# ===== RAG tuning ============================================================
# Documents returned from the vector store before reranking
TOP_K=10
# Documents kept after reranking (must be <= TOP_K)
RERANK_TOP_K=5

# ===== Reranker (optional) ===================================================
# Set to "false" to skip the cross-encoder reranker entirely.
# When true but the model cannot be loaded, the pipeline logs a warning and
# degrades to raw retrieval scores automatically.
RERANKER_ENABLED=false
# HuggingFace model id for the cross-encoder reranker
RERANKER_MODEL=bge-reranker-v2-m3
# Device: "cpu" or "mps"/"cuda" when available
RERANKER_DEVICE=cpu

# ===== Graph behaviour =======================================================
# Chat history size for one conversation thread (messages retained in state)
MAX_HISTORY_MESSAGES=8
# Max "rewrite the query and retrieve again" retries when the answer looks bad
MAX_RETRY=1
# Upper bound on model→tool→model round trips within one generation step
MAX_TOOL_ITERATIONS=3
